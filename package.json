{
  "name": "antredo",
  "version": "1.0.0",
  "description": "Ant game with p5.js and TypeScript",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && esbuild dist/sketch.js --bundle --outfile=dist/bundle.js --format=iife --global-name=AntGame",
    "watch": "tsc --watch & esbuild dist/sketch.js --bundle --outfile=dist/bundle.js --format=iife --global-name=AntGame --watch",
    "dev": "npm run watch",
    "test": "mocha",
    "test:watch": "mocha --watch",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug"
  },
  "keywords": [
    "game",
    "p5js",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/chai": "^4.3.0",
    "@types/mocha": "^10.0.0",
    "@types/node": "^20.0.0",
    "@types/p5": "^1.7.0",
    "chai": "^4.5.0",
    "esbuild": "^0.27.0",
    "mocha": "^10.8.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
